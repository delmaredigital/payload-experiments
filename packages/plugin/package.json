{
  "name": "@delmaredigital/payload-experiments",
  "version": "0.0.0",
  "description": "No-code A/B testing for Payload CMS and Next.js: block, page and flag experiments with holdouts, layers, exposure logging and honest statistics inside the admin — no vendor",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "swc ./src -d ./dist --strip-leading-paths --config-file ../../.swcrc && tsc --outDir dist && copyfiles -u 1 \"src/**/*.css\" dist",
    "dev": "swc ./src -d ./dist --strip-leading-paths --config-file ../../.swcrc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@payloadcms/next": ">=3.90.0 <4",
    "@payloadcms/ui": ">=3.90.0 <4",
    "@puckeditor/core": ">=0.24.0",
    "next": ">=16.4.1 <17",
    "payload": ">=3.90.0 <4",
    "react": ">=19.2.1 <20",
    "react-dom": ">=19.2.1 <20"
  },
  "peerDependenciesMeta": {
    "@puckeditor/core": { "optional": true }
  },
  "dependencies": {
    "@delmaredigital/experiments-stats": "workspace:*"
  },
  "keywords": ["payload", "payloadcms", "payload-plugin", "ab-testing", "experimentation", "feature-flags", "puck", "nextjs"],
  "engines": { "node": ">=22.23.4" },
  "author": "Delmare Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delmaredigital/payload-experiments.git",
    "directory": "packages/plugin"
  },
  "bugs": { "url": "https://github.com/delmaredigital/payload-experiments/issues" },
  "homepage": "https://delmaredigital.com/developers"
}
