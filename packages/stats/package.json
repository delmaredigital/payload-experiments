{
  "name": "@delmaredigital/experiments-stats",
  "version": "0.0.0",
  "description": "Experiment statistics engine: deterministic assignment, frequentist and Bayesian inference, sequential testing, CUPED, SRM and power — a TypeScript port of GrowthBook's gbstats",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "swc ./src -d ./dist --strip-leading-paths --config-file ../../.swcrc && tsc --outDir dist",
    "dev": "swc ./src -d ./dist --strip-leading-paths --config-file ../../.swcrc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "keywords": ["ab-testing", "experimentation", "statistics", "bayesian", "sequential-testing", "cuped", "srm", "growthbook"],
  "engines": { "node": ">=22.23.4" },
  "author": "Delmare Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delmaredigital/payload-experiments.git",
    "directory": "packages/stats"
  },
  "homepage": "https://delmaredigital.com/developers"
}
