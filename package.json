{
  "name": "payload-experiments-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "clean": "pnpm -r --filter './packages/*' clean",
    "parity:generate": "python3 -I scripts/gbstats-parity/generate.py",
    "parity:check": "vitest run --project stats tests/parity",
    "fixtures:puck-editor": "vitest run --config vitest.fixtures.config.ts packages/plugin/tests-fixtures/puck",
    "fixtures:admin-nav": "vitest run --config vitest.fixtures.config.ts packages/plugin/tests-fixtures/admin",
    "generate:editor-css": "node scripts/generate-editor-css.mjs",
    "fixtures:admin-home": "vitest run --config vitest.fixtures.config.ts packages/plugin/tests-fixtures/admin/renderHomeFixtures.fixture.tsx",
    "fixtures:ui": "vitest run --config vitest.fixtures.config.ts packages/plugin/tests-fixtures/ui",
    "fixtures:admin-results": "vitest run --config vitest.fixtures.config.ts packages/plugin/tests-fixtures/admin/renderResultsFixtures.fixture.tsx",
    "fixtures:admin-test": "vitest run --config vitest.fixtures.config.ts packages/plugin/tests-fixtures/admin/renderTestPageFixtures.fixture.tsx"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.6",
    "copyfiles": "^2.4.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.9.0",
  "author": "Delmare Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delmaredigital/payload-experiments.git"
  },
  "homepage": "https://delmaredigital.com/developers"
}
